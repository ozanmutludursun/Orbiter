{
  "name": "orbiter",
  "version": "0.1.14",
  "private": true,
  "type": "module",
  "license": "GPL-3.0-only",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "build": "rollup -c --forceExit",
    "build:preview": "vite build",
    "typecheck": "tsc --noEmit",
    "preview": "npm run build:preview && python3 scripts/preview_server.py",
    "test": "python3 -m unittest discover -s tests -v && node --test tests/test_rpc.mjs tests/test_notification.mjs tests/test_store.mjs",
    "package": "npm run build && python3 scripts/package.py"
  },
  "dependencies": {
    "@decky/api": "^1.1.3",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "tslib": "^2.7.0"
  },
  "devDependencies": {
    "@decky/rollup": "^1.0.2",
    "@decky/ui": "^4.11.0",
    "@types/react": "^19.1.1",
    "@types/react-dom": "^19.1.1",
    "typescript": "^5.6.2",
    "rollup": "^4.53.3",
    "vite": "^7.1.0"
  }
}
